---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import ProjectCard from "@/components/site/ProjectCard.astro";
import { image } from "@/lib/images";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("flagshipPage", locale);
if (!entry) throw new Error(`Missing flagship copy for locale "${locale}"`);
const t = entry.data;

const projects = await getCollection("projects");
const byId = (id: string) => projects.find((p) => p.id === id);

const exitForward = byId("exit-forward-model");
const pasarbaik = byId("pasarbaik");
const circular = byId("circular-economy-waste");
---

<Base
  locale={locale}
  path="/flagship"
  title={t.meta.title}
  description={t.meta.description}
  heroTone="ink"
  breadcrumbs={[{ name: t.header.title, path: "/flagship" }]}
>
  <PageHeader
    title={t.header.title}
    intro={t.header.intro}
    imageKey="hero-what-we-do"
    imageAlt={t.header.imageAlt}
  />

  {/* Exit Forward Model */}
  <section class="border-b border-line">
    <div class="grid lg:grid-cols-12">
      <div class="relative min-h-[20rem] lg:col-span-6 lg:min-h-[38rem]">
        <Image
          src={image("uniformed-team")}
          alt={t.exitForward.imageAlt}
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-center p-10 md:p-16 lg:col-span-6 lg:p-20">
        <h2 data-reveal class="display-2">{t.exitForward.title}</h2>
        <p data-reveal class="mt-3 text-[14px] text-ink-soft italic">
          {t.exitForward.subtitle}
        </p>
        <p
          data-reveal
          style="--reveal-delay:70ms"
          class="mt-6 text-[16px] leading-relaxed text-ink-soft"
        >
          {t.exitForward.body}
        </p>
      </div>
    </div>

    {/* Three stages: the sequence is the argument, so it stays ordered. */}
    <div class="edge py-16 md:py-20">
      <ol class="grid gap-px bg-line md:grid-cols-3">
        {
          t.exitForward.stages.map((stage, i) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`} class="bg-paper p-7">
              <p class="label">
                {String(i + 1).padStart(2, "0")}
              </p>
              <p class="display-3 mt-3">
                {stage.title}
              </p>
              <p class="mt-4 text-[13.5px] leading-relaxed text-ink-soft">
                {stage.body}
              </p>
              <p class="mt-6 text-[11.5px] tracking-[0.1em] text-bronze-strong uppercase">
                {stage.tag}
              </p>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-[14.5px] text-ink/80 italic">{t.exitForward.note}</p>

      {
        exitForward && (
          <div data-reveal class="mt-12">
            <ProjectCard
              project={exitForward.data[locale]}
              category="flagship"
              labels={t.labels}
            />
          </div>
        )
      }
    </div>
  </section>

  {/* PasarBaik */}
  <section class="border-b border-line">
    <div class="grid lg:grid-cols-12">
      <div class="relative order-2 min-h-[20rem] lg:order-1 lg:col-span-6 lg:min-h-[38rem]">
        <Image
          src={image("pillar-msme")}
          alt={t.pasarbaik.imageAlt}
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
      <div
        class="order-1 flex flex-col justify-center p-10 md:p-16 lg:order-2 lg:col-span-6 lg:p-20"
      >
        <h2 data-reveal class="display-2">{t.pasarbaik.title}</h2>
        <p data-reveal class="mt-3 text-[14px] text-ink-soft italic">
          {t.pasarbaik.subtitle}
        </p>
        <p
          data-reveal
          style="--reveal-delay:70ms"
          class="mt-6 text-[16px] leading-relaxed text-ink-soft"
        >
          {t.pasarbaik.body}
        </p>

        <dl data-reveal class="mt-10 grid gap-px bg-line sm:grid-cols-3">
          {
            t.pasarbaik.facts.map((fact) => (
              <div class="bg-paper p-5">
                <dt class="text-[11px] tracking-[0.1em] text-ink-soft uppercase">
                  {fact.key}
                </dt>
                <dd class="mt-2 text-[15px] leading-tight font-semibold">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <a
          href={t.pasarbaik.cta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary mt-10 w-fit"
        >
          {t.pasarbaik.cta.label}
          <Icon name="ph:arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>

    {
      pasarbaik && (
        <div class="edge py-16">
          <div data-reveal>
            <ProjectCard
              project={pasarbaik.data[locale]}
              category="flagship"
              labels={t.labels}
            />
          </div>
        </div>
      )
    }
  </section>

  {/* Circular economy */}
  <section>
    <div class="grid lg:grid-cols-12">
      <div class="p-10 md:p-16 lg:col-span-6 lg:p-20">
        <h2 data-reveal class="display-2">{t.circular.title}</h2>
        <p data-reveal class="mt-3 text-[14px] text-ink-soft italic">
          {t.circular.subtitle}
        </p>
        <p
          data-reveal
          style="--reveal-delay:70ms"
          class="mt-6 text-[16px] leading-relaxed text-ink-soft"
        >
          {t.circular.body}
        </p>

        <div class="mt-10">
          <h3 class="text-[12px] font-medium tracking-[0.14em] text-ink-soft uppercase">
            {t.circular.rolesHeading}
          </h3>
          <ul class="mt-5 space-y-3 text-[14.5px]">
            {
              t.circular.roles.map((role, i) => (
                <li class="flex gap-4">
                  <span class="label w-7 shrink-0">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                  <span>{role}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-[13.5px] text-ink-soft italic">
            {t.circular.rolesNote}
          </p>
        </div>

        <div class="mt-10 border-l border-bronze bg-surface/60 p-6">
          <p class="text-[14px] leading-relaxed">
            <strong class="font-medium">{t.circular.relevanceLabel}.</strong>{" "}
            {t.circular.relevance}
          </p>
        </div>
      </div>
      <div class="relative min-h-[20rem] lg:col-span-6 lg:min-h-[38rem]">
        <Image
          src={image("pillar-circular")}
          alt={t.circular.imageAlt}
          widths={[640, 1024]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>

    {
      circular && (
        <div class="edge py-16">
          <div data-reveal>
            <ProjectCard
              project={circular.data[locale]}
              category="flagship"
              labels={t.labels}
            />
          </div>
        </div>
      )
    }
  </section>
</Base>
