---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { image } from "@/lib/images";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("insightsPage", locale);
if (!entry) throw new Error(`Missing insights copy for locale "${locale}"`);
const t = entry.data;

const pieces = (await getCollection("insights")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  locale={locale}
  path="/insights"
  title={t.meta.title}
  description={t.meta.description}
  breadcrumbs={[{ name: t.header.title, path: "/insights" }]}
>
  <PageHeader
    title={t.header.title}
    intro={t.header.intro}
    imageKey="hero-insights"
    imageAlt={t.header.imageAlt}
  />

  <section class="grid border-b border-line lg:grid-cols-12">
    <div class="relative min-h-[18rem] lg:col-span-7 lg:min-h-[26rem]">
      <Image
        src={image("circle-discussion")}
        alt={t.practice.imageAlt}
        widths={[640, 1024]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
    <div
      class="flex flex-col justify-center bg-surface/60 p-10 md:p-14 lg:col-span-5 lg:p-16"
    >
      <h2 data-reveal class="font-display text-[25px] leading-tight text-balance md:text-[31px]">
        {t.practice.heading}
      </h2>
      <p data-reveal style="--reveal-delay:70ms" class="mt-5 text-[15px] leading-relaxed text-ink-soft">
        {t.practice.body}
      </p>
    </div>
  </section>

  <section class="edge py-20 md:py-26">
    <ul class="border-t border-hairline">
      {
        pieces.map((piece, i) => {
          const c = piece.data[locale];
          return (
            <li data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <article class="grid grid-cols-12 gap-x-6 gap-y-3 border-b border-hairline py-9">
                <p class="col-span-12 text-[11.5px] tracking-[0.1em] text-ink-soft uppercase md:col-span-2">
                  {c.kind}
                </p>
                <div class="col-span-12 md:col-span-8">
                  <h2 class="font-display text-[21px] leading-snug text-balance md:text-[25px]">
                    {c.title}
                  </h2>
                  <p class="mt-3 max-w-[60ch] text-[14.5px] leading-relaxed text-ink-soft">
                    {c.excerpt}
                  </p>
                </div>
                <div class="col-span-12 md:col-span-2 md:justify-self-end">
                  {piece.data.forthcoming ? (
                    <span class="text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
                      {t.forthcoming}
                    </span>
                  ) : (
                    <a href={piece.data.href} class="link-rule text-[13.5px]">
                      <Icon name="ph:arrow-up-right" class="h-4 w-4" />
                    </a>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>

    <div
      data-reveal
      class="mt-16 grid gap-8 rounded-[2px] border border-line bg-surface/50 p-8 md:grid-cols-12 md:p-12"
    >
      <div class="md:col-span-7">
        <h2 class="font-display text-[25px] leading-tight text-balance md:text-[30px]">
          {t.briefing.heading}
        </h2>
        <p class="mt-4 max-w-[55ch] text-[15px] text-ink-soft">
          {t.briefing.body}
        </p>
      </div>
      <div class="flex md:col-span-5 md:items-end md:justify-end">
        <a href={t.briefing.cta.href} class="btn btn-primary">
          {t.briefing.cta.label}
          <Icon name="ph:arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</Base>
