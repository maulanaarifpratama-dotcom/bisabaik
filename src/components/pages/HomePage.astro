---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import { localizePath, type Locale } from "@/i18n";
import { image } from "@/lib/images";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("home", locale);
if (!entry) throw new Error(`Missing home copy for locale "${locale}"`);
const t = entry.data;

const flagships = (await getCollection("projects"))
  .filter((p) => p.data.category === "flagship")
  .sort((a, b) => a.data.order - b.data.order);

const partners = (await getCollection("partners")).sort(
  (a, b) => a.data.order - b.data.order,
);

const href = (path: string) =>
  path.startsWith("http") ? path : localizePath(path, locale);

const [lead, ...rest] = flagships;
---

<Base
  locale={locale}
  path="/"
  title={t.meta.title}
  description={t.meta.description}
  heroTone="ink"
  isHome
>
  {/* 1. Hero. Ink ground, oversized wide-set type, lines rising in sequence. */}
  <section class="band-ink relative isolate overflow-hidden">
    <div class="hero-media absolute inset-0">
      <Image
        src={image("hero-delivery")}
        alt={t.hero.imageAlt}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
    <!-- Three scrims, three jobs. Each is dense only where something has to
         stay readable, so the middle and right of the frame stay photographic. -->
    <div class="absolute inset-x-0 top-0 h-28 bg-linear-to-b from-band/85 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-r from-band via-band/52 to-band/5"></div>
    <div class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-band via-band/70 to-transparent"></div>

    <div
      class="edge relative flex min-h-[36rem] flex-col justify-end pt-32 pb-16 md:min-h-[43rem] md:pb-20"
    >
      <h1 class="display-1 max-w-[13ch]">
        <span class="hero-line" style="--line-index:0"
          ><span>{t.hero.lineOne}</span></span
        >
        <span class="hero-line" style="--line-index:1"
          ><span>{t.hero.lineTwo}</span></span
        >
        <span class="hero-line" style="--line-index:2"
          ><span class="text-band-accent">{t.hero.lineThree}</span></span
        >
      </h1>

      <div class="mt-12 grid gap-8 lg:grid-cols-12 lg:items-end">
        <p
          data-reveal
          style="--reveal-delay:320ms"
          class="text-[17px] leading-relaxed text-on-band/80 md:text-[18.5px] lg:col-span-6"
        >
          {t.hero.body}
        </p>
        <div
          data-reveal
          style="--reveal-delay:400ms"
          class="flex flex-wrap gap-3 lg:col-span-5 lg:col-start-8 lg:justify-end"
        >
          <a href={href(t.hero.primary.href)} class="btn btn-invert group">
            {t.hero.primary.label}
            <Icon
              name="ph:arrow-right"
              class="h-4 w-4 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1"
            />
          </a>
          <a
            href={href(t.hero.secondary.href)}
            class="btn btn-outline-invert group"
          >
            {t.hero.secondary.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* 2. Positioning. The claim, held against the people it describes. */}
  <section class="edge pt-20 pb-14 md:pt-24 md:pb-16">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
      <p data-reveal class="display-3 text-pretty lg:col-span-6 lg:text-[2rem] lg:leading-[1.22]">
        {t.positioning.lead}<em class="italic">{t.positioning.emphasisOne}</em
        >{t.positioning.middle}<em class="italic">{t.positioning.emphasisTwo}</em
        >{t.positioning.tail}
      </p>
      <div
        data-reveal-clip
        class="relative aspect-4/5 overflow-hidden lg:col-span-5 lg:col-start-8"
      >
        <Image
          src={image("circular-economy")}
          alt={t.positioning.imageAlt}
          widths={[420, 720]}
          sizes="(min-width: 1024px) 38vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* 3. Pillars. Asymmetric grid, one cell per pillar, the first with an image. */}
  <section class="edge border-t border-line pt-20 pb-14 md:pt-24 md:pb-16">
    <div data-reveal class="max-w-3xl">
      <h2 class="display-2">{t.pillars.heading}</h2>
      <p class="prose-measure mt-7 text-[16.5px] leading-relaxed text-ink-soft">
        {t.pillars.body}
      </p>
    </div>

    <div class="mt-16 grid gap-px bg-line lg:grid-cols-12">
      <article
        data-reveal
        class="relative isolate flex min-h-[24rem] flex-col justify-end overflow-hidden bg-band p-9 md:p-12 lg:col-span-7"
      >
        <Image
          src={image("uniformed-team")}
          alt=""
          aria-hidden="true"
          widths={[640, 960]}
          sizes="(min-width: 1024px) 55vw, 100vw"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-t from-band via-band/90 to-band/40"></div>
        <span aria-hidden="true" class="relative block h-px w-12 bg-band-accent"></span>
        <h3 class="display-3 relative mt-6 text-on-band">
          {t.pillars.items[0]?.title}
        </h3>
        <p class="relative mt-4 max-w-md text-[15px] leading-relaxed text-on-band/80">
          {t.pillars.items[0]?.body}
        </p>
      </article>

      <div class="grid gap-px bg-line lg:col-span-5">
        <article
          data-reveal
          style="--reveal-delay:80ms"
          class="bg-surface-2 p-9 md:p-11"
        >
          <span aria-hidden="true" class="block h-px w-12 bg-bronze"></span>
          <h3 class="display-3 mt-6">{t.pillars.items[1]?.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
            {t.pillars.items[1]?.body}
          </p>
        </article>
        <article
          data-reveal
          style="--reveal-delay:150ms"
          class="bg-paper p-9 md:p-11"
        >
          <span aria-hidden="true" class="block h-px w-12 bg-bronze"></span>
          <h3 class="display-3 mt-6">{t.pillars.items[2]?.title}</h3>
          <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
            {t.pillars.items[2]?.body}
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* 4. Journey. A stepper: here the numerals carry the information. */}
  <section class="border-y border-line bg-surface/60 pt-20 pb-14 md:pt-24 md:pb-16">
    <div class="edge">
      <div data-reveal class="max-w-3xl">
        <h2 class="display-2">{t.journey.heading}</h2>
        <p class="prose-measure mt-7 text-[16.5px] leading-relaxed text-ink-soft">
          {t.journey.body}
        </p>
      </div>

      <ol class="mt-16 grid gap-y-14 md:grid-cols-3 md:gap-x-10">
        {
          t.journey.phases.map((phase, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <div class="flex items-end justify-between border-b-2 border-ink pb-4">
                <span class="display-2 leading-none">{phase.numeral}</span>
                <span class="label pb-1">
                  {t.journey.phaseLabel} {phase.numeral}
                </span>
              </div>
              <h3 class="display-3 mt-7">{phase.title}</h3>
              <p class="mt-4 text-[15px] leading-relaxed text-ink-soft">
                {phase.body}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* 5. Flagships. One lead with an image, the remainder as an index. */}
  <section class="edge pt-20 pb-14 md:pt-24 md:pb-16">
    <div data-reveal class="max-w-3xl">
      <h2 class="display-2">{t.flagship.heading}</h2>
      <p class="prose-measure mt-7 text-[16.5px] leading-relaxed text-ink-soft">
        {t.flagship.body}
      </p>
    </div>

    {
      lead && (
        <a
          href={href("/flagship")}
          class="group mt-16 grid overflow-hidden border-t-2 border-ink lg:grid-cols-12"
        >
          <div
            data-reveal
            data-reveal-clip
            class="relative min-h-[16rem] lg:col-span-7 lg:min-h-[26rem]"
          >
            <Image
              src={image("pillar-msme")}
              alt=""
              aria-hidden="true"
              widths={[640, 1024]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out)] group-hover:scale-[1.04]"
            />
          </div>
          <div class="flex flex-col justify-center py-9 lg:col-span-5 lg:py-12 lg:pl-12">
            <h3 class="display-3">{lead.data[locale].title}</h3>
            <p class="mt-5 text-[15px] leading-relaxed text-ink-soft">
              {lead.data[locale].context}
            </p>
            <span class="link-rule mt-8 text-[13.5px]">
              {t.flagship.readMore}
              <Icon
                name="ph:arrow-right"
                class="h-3.5 w-3.5 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1"
              />
            </span>
          </div>
        </a>
      )
    }

    <ul>
      {
        rest.map((project, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <a
              href={href("/flagship")}
              class="group grid grid-cols-12 items-baseline gap-x-6 gap-y-2 border-t border-hairline py-8 transition-colors duration-300 hover:bg-surface/70"
            >
              <h3 class="display-3 col-span-12 md:col-span-5">
                {project.data[locale].title}
              </h3>
              <p class="col-span-12 text-[14.5px] leading-relaxed text-ink-soft md:col-span-6">
                {project.data[locale].context}
              </p>
              <Icon
                name="ph:arrow-up-right"
                class="col-span-12 h-4 w-4 text-ink-soft transition-transform duration-300 ease-[var(--ease-out)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5 md:col-span-1 md:justify-self-end"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 6. Principles. Full-bleed split, photograph against ink. */}
  <section class="grid lg:grid-cols-12">
    <div
      data-reveal
      data-reveal-clip
      class="relative min-h-[22rem] lg:col-span-7 lg:min-h-[36rem]"
    >
      <Image
        src={image("circle-discussion")}
        alt={t.principles.imageAlt}
        widths={[768, 1280]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>
    <div
      class="band-ink flex flex-col justify-center p-10 md:p-16 lg:col-span-5 lg:p-20"
    >
      <span aria-hidden="true" class="block h-px w-12 bg-band-accent"></span>
      <h2 data-reveal class="display-2 mt-7">{t.principles.heading}</h2>
      <p
        data-reveal
        style="--reveal-delay:80ms"
        class="mt-6 text-[15.5px] leading-relaxed text-on-band/80"
      >
        {t.principles.body}
      </p>
      <a
        data-reveal
        style="--reveal-delay:150ms"
        href={href(t.principles.cta.href)}
        class="btn btn-outline-invert group mt-10 w-fit"
      >
        {t.principles.cta.label}
        <Icon
          name="ph:arrow-right"
          class="h-4 w-4 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1"
        />
      </a>
    </div>
  </section>

  {/* 7. Partners. An index of who and in what role, not a logo wall. */}
  <section class="edge pt-20 pb-14 md:pt-24 md:pb-16">
    <div
      data-reveal
      class="flex flex-col justify-between gap-6 border-b-2 border-ink pb-8 md:flex-row md:items-end"
    >
      <h2 class="display-2 max-w-[18ch]">{t.partners.heading}</h2>
      <a href={href(t.partners.cta.href)} class="link-rule shrink-0 text-[14px]">
        {t.partners.cta.label}
        <Icon name="ph:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <ul class="grid gap-x-14 md:grid-cols-2">
      {
        partners.map((partner) => (
          <li class="grid grid-cols-12 items-baseline gap-x-4 border-b border-hairline py-5">
            <span class="col-span-12 text-[17px] leading-snug font-medium sm:col-span-7">
              {partner.data[locale].name}
            </span>
            <span class="label col-span-12 leading-snug sm:col-span-5 sm:text-right">
              {partner.data[locale].role}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 8. Closing band. */}
  <section class="band-ink">
    <div class="edge grid gap-10 py-20 md:grid-cols-12 md:items-end md:py-28">
      <div class="md:col-span-7">
        <span aria-hidden="true" class="block h-px w-12 bg-band-accent"></span>
        <h2 data-reveal class="display-2 mt-7 text-balance">{t.close.heading}</h2>
        <p
          data-reveal
          style="--reveal-delay:80ms"
          class="prose-measure mt-6 text-[16.5px] leading-relaxed text-on-band/80"
        >
          {t.close.body}
        </p>
      </div>
      <div
        data-reveal
        style="--reveal-delay:150ms"
        class="flex flex-wrap gap-3 md:col-span-5 md:justify-end"
      >
        <a href={href(t.close.primary.href)} class="btn btn-invert group">
          {t.close.primary.label}
          <Icon
            name="ph:arrow-right"
            class="h-4 w-4 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1"
          />
        </a>
        <a
          href={t.close.secondary.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline-invert"
        >
          {t.close.secondary.label}
          <Icon name="ph:arrow-up-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Scroll-driven parallax on the hero photograph. It is the one authored
     motion moment on the page; everything else only fades or wipes in.
     Browsers without scroll-driven animations get a still image. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-media {
        animation: hero-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        will-change: transform;
      }

      @keyframes hero-drift {
        from {
          transform: translate3d(0, -3.5%, 0) scale(1.1);
        }
        to {
          transform: translate3d(0, 3.5%, 0) scale(1.02);
        }
      }
    }
  }
</style>
