---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import { image } from "@/lib/images";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("contact", locale);
const commonEntry = await getEntry("common", locale);
if (!entry || !commonEntry) {
  throw new Error(`Missing contact copy for locale "${locale}"`);
}
const t = entry.data;
const f = t.form;
const c = commonEntry.data;

const field =
  "w-full rounded-[2px] border border-line bg-surface-2 px-3.5 py-2.5 text-[15px] text-ink placeholder:text-ink-soft/70 transition-colors duration-200 focus:border-ink focus:outline-none";
const label =
  "block text-[12px] font-medium tracking-[0.1em] text-ink-soft uppercase";
---

<Base
  locale={locale}
  path="/contact"
  title={t.meta.title}
  description={t.meta.description}
  heroTone="ink"
  breadcrumbs={[{ name: t.header.title, path: "/contact" }]}
>
  <PageHeader
    title={t.header.title}
    intro={t.header.intro}
    imageKey="hero-contact"
    imageAlt={t.header.imageAlt}
  />

  <section class="edge py-20 md:py-26">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="sr-only">{f.heading}</h2>

        <form
          data-contact-form
          class="space-y-7"
          novalidate
          data-copy-success-title={f.successTitle}
          data-copy-success-body={f.successBody}
          data-copy-error-title={f.errorTitle}
          data-copy-error-body={f.errorBody}
          data-copy-submit={f.submit}
          data-copy-submitting={f.submitting}
        >
          <div class="grid gap-7 md:grid-cols-2">
            <div>
              <label class={label} for="cf-name">{f.name}</label>
              <input
                class={`${field} mt-2`}
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder={f.namePlaceholder}
              />
            </div>
            <div>
              <label class={label} for="cf-email">{f.email}</label>
              <input
                class={`${field} mt-2`}
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder={f.emailPlaceholder}
              />
            </div>
            <div>
              <label class={label} for="cf-org">{f.org}</label>
              <input
                class={`${field} mt-2`}
                id="cf-org"
                name="org"
                type="text"
                autocomplete="organization"
                required
                placeholder={f.orgPlaceholder}
              />
            </div>
            <div>
              <label class={label} for="cf-role">
                {f.role}
                <span class="ml-1.5 normal-case tracking-normal opacity-70">
                  ({f.optional})
                </span>
              </label>
              <input
                class={`${field} mt-2`}
                id="cf-role"
                name="role"
                type="text"
                autocomplete="organization-title"
                placeholder={f.rolePlaceholder}
              />
            </div>
          </div>

          <div>
            <label class={label} for="cf-interest">{f.interest}</label>
            <select
              class={`${field} mt-2 cursor-pointer`}
              id="cf-interest"
              name="interest"
              required
            >
              <option value="" disabled selected>{f.interestPlaceholder}</option>
              {
                f.interestOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))
              }
            </select>
          </div>

          <div>
            <label class={label} for="cf-message">{f.message}</label>
            <textarea
              class={`${field} mt-2 resize-y`}
              id="cf-message"
              name="message"
              rows="5"
              required
              placeholder={f.messagePlaceholder}></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" class="btn btn-primary group" data-submit>
              <span data-submit-label>{f.submit}</span>
              <Icon
                name="ph:arrow-right"
                class="h-4 w-4 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1"
              />
            </button>

            <p
              data-form-status
              role="status"
              aria-live="polite"
              hidden
              class="mt-5 border-l-2 py-1 pl-4 text-[14px] leading-relaxed"
            >
            </p>

            <p class="mt-4 max-w-[52ch] text-[12.5px] leading-relaxed text-ink-soft">
              {f.consent}
            </p>
          </div>
        </form>
      </div>

      <aside class="space-y-10 lg:col-span-4 lg:col-start-9">
        <div>
          <h2 class="text-[12px] font-medium tracking-[0.14em] text-ink-soft uppercase">
            {t.direct.heading}
          </h2>
          <ul class="mt-5 space-y-5">
            <li class="flex items-start gap-4">
              <Icon name="ph:envelope-simple" class="mt-1 h-4 w-4 text-ink-soft" />
              <div>
                <p class="text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
                  {t.direct.emailLabel}
                </p>
                <a href={`mailto:${c.footer.email}`} class="link-rule text-[15px]">
                  {c.footer.email}
                </a>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <Icon name="ph:phone" class="mt-1 h-4 w-4 text-ink-soft" />
              <div>
                <p class="text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
                  {t.direct.phoneLabel}
                </p>
                <a href={c.footer.phoneHref} class="text-[15px]">{c.footer.phone}</a>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <Icon name="ph:map-pin" class="mt-1 h-4 w-4 text-ink-soft" />
              <div>
                <p class="text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
                  {t.direct.officeLabel}
                </p>
                <p class="text-[14.5px] leading-relaxed">
                  {c.footer.address.map((line) => <span class="block">{line}</span>)}
                </p>
              </div>
            </li>
          </ul>
        </div>

        <div class="border-t border-hairline pt-8">
          <h2 class="text-[12px] font-medium tracking-[0.14em] text-ink-soft uppercase">
            {t.related.heading}
          </h2>
          <ul class="mt-5 space-y-4">
            {
              c.footer.related.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-rule text-[14.5px]"
                  >
                    {item.label}
                    <Icon name="ph:arrow-up-right" class="h-3 w-3" />
                  </a>
                  <p class="mt-1 text-[12.5px] text-ink-soft">{item.note}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <div class="relative aspect-4/5 overflow-hidden rounded-[2px]">
            <Image
              src={image("uniformed-team")}
              alt={t.aside.imageAlt}
              widths={[400, 700]}
              sizes="(min-width: 1024px) 30vw, 100vw"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
          <p class="mt-3 text-[12px] text-ink-soft italic">{t.aside.caption}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLParagraphElement>("[data-form-status]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const buttonLabel = form.querySelector<HTMLElement>("[data-submit-label]")!;

    const copy = (key: string) => form.dataset[key] ?? "";

    let busy = false;

    function show(kind: "ok" | "error", title: string, body: string) {
      status.hidden = false;
      status.textContent = `${title}. ${body}`;
      status.classList.toggle("border-bronze", kind === "ok");
      status.classList.toggle("text-ink", kind === "ok");
      status.classList.toggle("border-danger", kind === "error");
      status.classList.toggle("text-danger", kind === "error");
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;

      // Let the browser surface its own field-level messages first.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      busy = true;
      button.disabled = true;
      button.classList.add("opacity-60");
      buttonLabel.textContent = copy("copySubmitting");
      status.hidden = true;

      const data = new FormData(form);
      const payload = Object.fromEntries(
        ["name", "email", "org", "role", "interest", "message"].map((key) => [
          key,
          String(data.get(key) ?? ""),
        ]),
      );

      try {
        const response = await fetch("/api/send-contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(String(response.status));

        show("ok", copy("copySuccessTitle"), copy("copySuccessBody"));
        form.reset();
      } catch {
        show("error", copy("copyErrorTitle"), copy("copyErrorBody"));
      } finally {
        busy = false;
        button.disabled = false;
        button.classList.remove("opacity-60");
        buttonLabel.textContent = copy("copySubmit");
      }
    });
  }
</script>
