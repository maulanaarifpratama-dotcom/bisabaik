---
import { getCollection, getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  slug: "privacy" | "terms" | "disclaimer";
}

const { locale, slug } = Astro.props;

const entry = await getEntry("legal", `${locale}/${slug}`);
if (!entry) throw new Error(`Missing legal page ${locale}/${slug}`);
const { Content } = await render(entry);

const common = await getEntry("common", locale);
if (!common) throw new Error(`Missing common copy for locale "${locale}"`);

const siblings = (await getCollection("legal"))
  .filter((doc) => doc.data.lang === locale)
  .sort((a, b) => a.data.order - b.data.order);

const path = `/${slug}`;
---

<Base
  locale={locale}
  path={path}
  title={entry.data.title}
  description={entry.data.description}
  breadcrumbs={[{ name: entry.data.title, path }]}
>
  <section class="edge pt-16 pb-12 md:pt-24 md:pb-16">
    <div class="max-w-3xl">
      <h1 data-reveal class="display-1">{entry.data.title}</h1>
      <p
        data-reveal
        style="--reveal-delay:80ms"
        class="mt-6 text-[17px] leading-relaxed text-ink-soft"
      >
        {entry.data.intro}
      </p>
      <p class="mt-6 text-[13px] text-ink-soft">
        {entry.data.updatedLabel}: {entry.data.updated}
      </p>
    </div>
  </section>

  <div class="edge grid gap-12 border-t border-line pt-12 pb-8 lg:grid-cols-12 lg:gap-16">
    <nav class="lg:col-span-3" aria-labelledby="legal-nav">
      <h2
        id="legal-nav"
        class="text-[12px] font-medium tracking-[0.14em] text-ink-soft uppercase"
      >
        {common.data.footer.legalHeading}
      </h2>
      <ul class="mt-5 space-y-2.5 text-[14px] lg:sticky lg:top-28">
        {
          siblings.map((doc) => (
            <li>
              <a
                href={localizePath(`/${doc.data.slug}`, locale)}
                aria-current={doc.data.slug === slug ? "page" : undefined}
                class:list={[
                  "transition-colors duration-200",
                  doc.data.slug === slug
                    ? "text-ink"
                    : "text-ink-soft hover:text-ink",
                ]}
              >
                {doc.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article class="prose-legal lg:col-span-8 lg:col-start-5">
      <Content />
    </article>
  </div>
</Base>
