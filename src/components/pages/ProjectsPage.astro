---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import ProjectCard from "@/components/site/ProjectCard.astro";
import { image } from "@/lib/images";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("projectsPage", locale);
if (!entry) throw new Error(`Missing projects copy for locale "${locale}"`);
const t = entry.data;

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const flagships = all.filter((p) => p.data.category === "flagship");
const engagements = all.filter((p) => p.data.category === "engagement");
---

<Base
  locale={locale}
  path="/projects"
  title={t.meta.title}
  description={t.meta.description}
  heroTone="ink"
  breadcrumbs={[{ name: t.header.title, path: "/projects" }]}
>
  <PageHeader
    title={t.header.title}
    intro={t.header.intro}
    imageKey="hero-projects"
    imageAlt={t.header.imageAlt}
  />

  <section class="edge border-b border-line pt-16 pb-12 md:pt-20 md:pb-14">
    <div class="mb-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 data-reveal class="display-2">{t.flagship.heading}</h2>
        <p
          data-reveal
          style="--reveal-delay:70ms"
          class="mt-5 max-w-[50ch] text-[15.5px] leading-relaxed text-ink-soft"
        >
          {t.flagship.body}
        </p>
      </div>
      <div data-reveal class="lg:col-span-7">
        <div class="relative aspect-16/9 overflow-hidden rounded-[2px]">
          <Image
            src={image("hero-delivery")}
            alt={t.flagship.imageAlt}
            widths={[640, 1024]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <div class="space-y-8">
      {
        flagships.map((project, i) => (
          <div data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <ProjectCard
              project={project.data[locale]}
              category={project.data.category}
              labels={t.labels}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section class="edge pt-16 pb-12 md:pt-20 md:pb-14">
    <div data-reveal class="max-w-3xl">
      <h2 class="display-2">{t.engagements.heading}</h2>
      <p class="prose-measure mt-5 text-[16.5px] leading-relaxed text-ink-soft">
        {t.engagements.body}
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        engagements.map((project, i) => (
          <div data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`} class="h-full">
            <ProjectCard
              project={project.data[locale]}
              category={project.data.category}
              labels={t.labels}
              variant="compact"
            />
          </div>
        ))
      }
    </div>
  </section>
</Base>
