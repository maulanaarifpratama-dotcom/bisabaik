---
import { Icon } from "astro-icon/components";

export interface ProjectLabels {
  context: string;
  role: string;
  scope: string;
  exit: string;
  signal: string;
  flagship: string;
  engagement: string;
}

export interface ProjectContent {
  title: string;
  partner?: string;
  context: string;
  role: string;
  scope: string;
  exit: string;
  signal: string;
}

interface Props {
  project: ProjectContent;
  category: "flagship" | "engagement";
  labels: ProjectLabels;
  variant?: "full" | "compact";
}

const { project, category, labels, variant = "full" } = Astro.props;

const rows = [
  { label: labels.context, value: project.context },
  { label: labels.role, value: project.role },
  { label: labels.scope, value: project.scope },
  { label: labels.exit, value: project.exit },
] as const;
---

{
  variant === "compact" ? (
    <article class="group flex h-full flex-col rounded-[2px] border border-line bg-surface-2 p-7 transition-[border-color,transform,box-shadow] duration-400 ease-[var(--ease-out)] hover:-translate-y-0.5 hover:border-ink/35 hover:shadow-[0_18px_40px_-26px_rgb(var(--shadow-tint)/0.35)]">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          {project.partner && (
            <p class="mb-2.5 text-[11.5px] leading-snug tracking-[0.1em] text-ink-soft uppercase">
              {project.partner}
            </p>
          )}
          <h3 class="font-display text-[21px] leading-snug">{project.title}</h3>
        </div>
        <Icon
          name="ph:arrow-up-right"
          class="mt-1 h-4 w-4 shrink-0 text-ink-soft transition-transform duration-400 ease-[var(--ease-out)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        />
      </div>
      <p class="flex-1 text-[14px] leading-relaxed text-ink-soft">
        {project.context}
      </p>
      <p class="mt-5 border-t border-hairline pt-4 text-[13px] text-ink/85">
        <span class="text-ink-soft">{labels.signal}. </span>
        {project.signal}
      </p>
    </article>
  ) : (
    <article class="rounded-[2px] border border-line bg-surface-2 p-7 md:p-10">
      <header class="mb-7 flex flex-col justify-between gap-4 border-b border-hairline pb-6 md:flex-row md:items-end">
        <div>
          {project.partner && (
            <p class="mb-2.5 text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
              {project.partner}
            </p>
          )}
          <h3 class="font-display text-[27px] leading-tight md:text-[33px]">
            {project.title}
          </h3>
        </div>
        <span class="shrink-0 text-[11.5px] tracking-[0.1em] text-ink-soft uppercase">
          {category === "flagship" ? labels.flagship : labels.engagement}
        </span>
      </header>

      <dl class="divide-y divide-hairline">
        {rows.map((row) => (
          <div class="grid grid-cols-12 gap-x-5 gap-y-1 py-4 first:pt-0">
            <dt class="col-span-12 pt-0.5 text-[11.5px] tracking-[0.1em] text-ink-soft uppercase sm:col-span-4">
              {row.label}
            </dt>
            <dd class="col-span-12 text-[14.5px] leading-relaxed text-ink/90 sm:col-span-8">
              {row.value}
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-6 border-l border-bronze pl-5 text-[14.5px] leading-relaxed text-ink/90">
        <span class="text-ink-soft">{labels.signal}. </span>
        {project.signal}
      </p>
    </article>
  )
}
