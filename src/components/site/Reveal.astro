---
export interface Props {
  /** Stagger in milliseconds. Keep it short; long cascades read as lag. */
  delay?: number;
  as?: "div" | "section" | "article" | "li" | "header";
  class?: string;
}

const { delay = 0, as: Tag = "div", class: className } = Astro.props;
---

<Tag
  data-reveal
  class={className}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>
