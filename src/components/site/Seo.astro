---
import {
  HTML_LANG,
  OG_LOCALE,
  SITE_URL,
  absoluteUrl,
  alternates,
  type Locale,
} from "@/i18n";

export interface Breadcrumb {
  name: string;
  /** Language-neutral path, e.g. "/about". Omit for the current page. */
  path?: string;
}

interface Props {
  locale: Locale;
  /** Language-neutral path for this page, e.g. "/about". */
  path: string;
  title: string;
  description: string;
  breadcrumbs?: Breadcrumb[];
  /** Emitted on the home page only. */
  isHome?: boolean;
  noindex?: boolean;
}

const {
  locale,
  path,
  title,
  description,
  breadcrumbs = [],
  isHome = false,
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path, locale);
const ogImage = `${SITE_URL}/og-image.jpg`;
const hreflang = alternates(path);

const organization = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Bisa Baik Bersama",
  alternateName: ["BisaBaik Foundation", "BisaBaik", "bisabaik.or.id"],
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/favicon-512.png`,
  image: ogImage,
  email: "info@bisabaik.or.id",
  telephone: "+62-851-6147-9098",
  description,
  foundingDate: "2020",
  parentOrganization: { "@type": "Organization", name: "Immers Asia Corp" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Sepat No. 43, Kebagusan, Pasar Minggu",
    addressLocality: "Jakarta Selatan",
    addressRegion: "DKI Jakarta",
    postalCode: "12520",
    addressCountry: "ID",
  },
  areaServed: [
    { "@type": "Country", name: "Indonesia" },
    { "@type": "Country", name: "Türkiye" },
  ],
  knowsLanguage: ["en", "id"],
  knowsAbout: [
    "Impact delivery",
    "Responsible exit design",
    "MSME aggregation",
    "Market access",
    "Monitoring, Evaluation, Accountability and Learning",
    "Circular economy",
  ],
  sameAs: ["https://pasarbaik.com"],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Bisa Baik Bersama",
  url: `${SITE_URL}/`,
  inLanguage: ["en", "id"],
  publisher: { "@type": "Organization", name: "Bisa Baik Bersama" },
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { name: locale === "id" ? "Beranda" : "Home", path: "/" },
          ...breadcrumbs,
        ].map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: absoluteUrl(item.path ?? path, locale),
        })),
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{
  hreflang.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Bisa Baik Bersama" />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Bisa Baik Bersama. Deliver well, exit responsibly, sustain impact."
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="author" content="Bisa Baik Bersama" />
<meta name="language" content={HTML_LANG[locale]} />

{
  isHome && (
    <>
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(organization)}
      />
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(website)}
      />
    </>
  )
}
{
  breadcrumbList && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbList)}
    />
  )
}
