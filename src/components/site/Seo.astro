---
import {
  HTML_LANG,
  OG_LOCALE,
  SITE_URL,
  absoluteUrl,
  alternates,
  type Locale,
} from "@/i18n";

export interface Breadcrumb {
  name: string;
  /** Language-neutral path, e.g. "/about". Omit for the current page. */
  path?: string;
}

interface Props {
  locale: Locale;
  /** Language-neutral path for this page, e.g. "/about". */
  path: string;
  title: string;
  description: string;
  breadcrumbs?: Breadcrumb[];
  /** Emitted on the home page only. */
  isHome?: boolean;
  /**
   * The schema.org type for this page. ContactPage and AboutPage are the two
   * an answer engine actually treats differently: they are where it expects to
   * find the organisation itself rather than a claim about it.
   */
  pageType?: "WebPage" | "ContactPage" | "AboutPage" | "CollectionPage";
  noindex?: boolean;
}

const {
  locale,
  path,
  title,
  description,
  breadcrumbs = [],
  isHome = false,
  pageType = "WebPage",
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path, locale);
const ogImage = `${SITE_URL}/og-image.jpg`;
const hreflang = alternates(path);

/* The organisation is emitted wherever a reader could reasonably arrive
   looking for the organisation itself: the home page, About, and Contact.
   Before, it lived on the home page alone, so anyone landing on /contact from
   a search for the office or the phone number found a page that described
   itself and never named the entity it belonged to. */
const emitOrganization =
  isHome || pageType === "ContactPage" || pageType === "AboutPage";

const organization = {
  "@context": "https://schema.org",
  "@type": "NGO",
  "@id": `${SITE_URL}/#organization`,
  name: "Bisa Baik Bersama",
  alternateName: ["BisaBaik Foundation", "BisaBaik", "bisabaik.or.id"],
  url: `${SITE_URL}/`,
  logo: {
    "@type": "ImageObject",
    url: `${SITE_URL}/favicon-512.png`,
    width: 512,
    height: 512,
    caption: "Bisa Baik Bersama",
  },
  image: ogImage,
  email: "info@bisabaik.or.id",
  telephone: "+62-878-8379-9175",
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "partnerships",
      email: "info@bisabaik.or.id",
      telephone: "+62-878-8379-9175",
      availableLanguage: ["en", "id"],
      areaServed: "ID",
    },
    {
      "@type": "ContactPoint",
      contactType: "partnerships",
      name: "WhatsApp",
      telephone: "+62-878-8379-9175",
      url: "https://wa.me/6287883799175",
      availableLanguage: ["en", "id"],
      areaServed: "ID",
    },
  ],
  description:
    "An Indonesia-based impact delivery partner. It runs development programs " +
    "on the ground for philanthropic, corporate, government and development " +
    "institutions, designs the exit from the first day, and keeps livelihoods " +
    "earning afterwards through MSME market access.",
  foundingDate: "2020",
  parentOrganization: { "@type": "Organization", name: "Immers Asia Corp" },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Jl. Raya Muchtar RT 05 RW 07 No. 7, Sawangan",
    addressLocality: "Depok",
    addressRegion: "Jawa Barat",
    postalCode: "16511",
    addressCountry: "ID",
  },
  areaServed: [
    { "@type": "Country", name: "Indonesia" },
    { "@type": "Country", name: "Türkiye" },
  ],
  knowsLanguage: ["en", "id"],
  knowsAbout: [
    "Impact delivery",
    "Responsible exit design",
    "MSME aggregation",
    "Market access",
    "Monitoring, Evaluation, Accountability and Learning",
    "Circular economy",
  ],
  sameAs: [
    "https://pasarbaik.com",
    "https://impactory.id",
    "https://wa.me/6287883799175",
  ],
};

/* Every page declares itself as a WebPage tied to the organisation. Answer
   engines lean on this to attribute a claim to the right entity. */
const webPage = {
  "@context": "https://schema.org",
  "@type": pageType,
  "@id": canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: HTML_LANG[locale],
  isPartOf: { "@type": "WebSite", "@id": `${SITE_URL}/#website` },
  about: { "@id": `${SITE_URL}/#organization` },
  publisher: { "@id": `${SITE_URL}/#organization` },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_URL}/#website`,
  name: "Bisa Baik Bersama",
  url: `${SITE_URL}/`,
  inLanguage: ["en", "id"],
  publisher: { "@id": `${SITE_URL}/#organization` },
};

const breadcrumbList =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { name: locale === "id" ? "Beranda" : "Home", path: "/" },
          ...breadcrumbs,
        ].map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: absoluteUrl(item.path ?? path, locale),
        })),
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  hreflang.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Bisa Baik Bersama" />
<meta property="og:locale" content={OG_LOCALE[locale]} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Bisa Baik Bersama. Deliver well, exit responsibly, sustain impact."
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta
  name="twitter:image:alt"
  content="Bisa Baik Bersama. Deliver well, exit responsibly, sustain impact."
/>

<meta
  name="robots"
  content={
    noindex
      ? "noindex, nofollow"
      : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  }
/>
<meta name="author" content="Bisa Baik Bersama" />
<meta name="language" content={HTML_LANG[locale]} />

{
  emitOrganization && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(organization)}
    />
  )
}
{
  isHome && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(website)}
    />
  )
}
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(webPage)}
/>
{
  breadcrumbList && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbList)}
    />
  )
}
