---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import { localizePath, type Locale } from "@/i18n";
import logoLight from "@/assets/logo-bisabaik-official.png";
import logoDark from "@/assets/logo-bisabaik-dark.png";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const entry = await getEntry("common", locale);
if (!entry) throw new Error(`Missing common copy for locale "${locale}"`);
const t = entry.data;
const f = t.footer;

const year = new Date().getFullYear();
const heading =
  "text-[11.5px] font-semibold tracking-[0.14em] text-ink-soft uppercase";
---

<footer class="mt-28 border-t-2 border-ink bg-surface/50">
  <div class="edge pt-16 pb-12 md:pt-20 md:pb-14">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Image
          src={logoLight}
          alt="Bisa Baik Bersama, Rumah Pembangunan Berkelanjutan"
          width={320}
          densities={[1, 2]}
          loading="lazy"
          class="logo-on-light h-12 w-auto object-contain"
        />
        <Image
          src={logoDark}
          alt="Bisa Baik Bersama, Rumah Pembangunan Berkelanjutan"
          width={320}
          densities={[1, 2]}
          loading="lazy"
          class="logo-on-dark h-12 w-auto object-contain"
        />
        <p class="display-3 mt-8 max-w-md">{f.tagline}</p>
        <p class="mt-5 max-w-md text-[14.5px] leading-relaxed text-ink-soft">
          {f.blurb}
        </p>
      </div>

      <nav class="md:col-span-2" aria-labelledby="footer-nav">
        <h2 id="footer-nav" class={heading}>{f.navHeading}</h2>
        <ul class="mt-5 space-y-2.5 text-[14px]">
          {
            t.nav.map((item) => (
              <li>
                <a
                  href={localizePath(item.href, locale)}
                  class="text-ink-soft transition-colors duration-200 hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-2">
        <h2 class={heading}>{f.contactHeading}</h2>
        <ul class="mt-5 space-y-2.5 text-[14px] text-ink-soft">
          <li>
            <a href={`mailto:${f.email}`} class="link-rule text-ink">{f.email}</a>
          </li>
          <li><a href={f.phoneHref} class="hover:text-ink">{f.phone}</a></li>
          <li class="leading-relaxed">
            {f.address.map((line) => <span class="block">{line}</span>)}
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class={heading}>{f.relatedHeading}</h2>
        <ul class="mt-5 space-y-4">
          {
            f.related.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-baseline gap-1.5 text-[14.5px] text-ink"
                >
                  <span class="link-rule">{item.label}</span>
                  <Icon
                    name="ph:arrow-up-right"
                    class="h-3 w-3 shrink-0 self-center transition-transform duration-200 ease-[var(--ease-out)] group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  />
                </a>
                <p class="mt-1 text-[12.5px] text-ink-soft">{item.note}</p>
              </li>
            ))
          }
        </ul>

        <h2 class={`${heading} mt-9`}>{f.legalHeading}</h2>
        <ul class="mt-5 space-y-2.5 text-[14px]">
          {
            f.legal.map((item) => (
              <li>
                <a
                  href={localizePath(item.href, locale)}
                  class="text-ink-soft transition-colors duration-200 hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-3 border-t border-hairline pt-7 text-[12px] text-ink-soft md:flex-row md:items-center"
    >
      <p>&copy; {year} {f.copyright}</p>
      <p>{f.affiliation}</p>
    </div>
  </div>
</footer>
