---
import { Image } from "astro:assets";
import { image, type ImageKey } from "@/lib/images";

interface Props {
  title: string;
  intro: string;
  imageKey: ImageKey;
  imageAlt: string;
  /**
   * Mirror the photograph. The headline sits on the left, so a subject who
   * happens to be on the left would be read through the type. Mirroring is
   * only safe where the frame has no lettering in it.
   */
  flip?: boolean;
}

const { title, intro, imageKey, imageAlt, flip = false } = Astro.props;
const photo = image(imageKey);
---

<section class="band-ink relative isolate overflow-hidden">
  <div class="absolute inset-0">
    <Image
      src={photo}
      alt={imageAlt}
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={58}
      class:list={["h-full w-full object-cover", flip && "-scale-x-100"]}
    />
  </div>

  <!-- The photograph is atmosphere here, not subject. The type has to win. -->
  <div
    class="absolute inset-x-0 top-0 h-36 bg-linear-to-b from-band/90 via-band/62 to-transparent"
  >
  </div>
  <div class="absolute inset-0 bg-linear-to-r from-band via-band/58 to-band/8"></div>
  <div class="absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-band via-band/72 to-transparent"></div>

  <div class="edge relative grid gap-10 pt-32 pb-20 md:pt-40 md:pb-28 lg:grid-cols-12">
    <div class="lg:col-span-9">
      <h1 class="display-1"><span class="hero-line"><span>{title}</span></span></h1>
    </div>
    <div class="lg:col-span-7">
      <span aria-hidden="true" class="block h-px w-16 bg-band-accent"></span>
      <p class="mt-6 text-[17px] leading-relaxed text-on-band/82 md:text-[18.5px]">
        {intro}
      </p>
    </div>
  </div>
</section>
