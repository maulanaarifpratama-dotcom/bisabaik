---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import {
  localizePath,
  otherLocale,
  stripLocale,
  type Locale,
} from "@/i18n";
import logoLight from "@/assets/logo-bisabaik-official.png";
import logoDark from "@/assets/logo-bisabaik-dark.png";

interface Props {
  locale: Locale;
  heroTone?: "ink" | "paper";
}

const { locale, heroTone = "paper" } = Astro.props;

const entry = await getEntry("common", locale);
if (!entry) throw new Error(`Missing common copy for locale "${locale}"`);
const t = entry.data;

const here = stripLocale(Astro.url.pathname);
const other = otherLocale(locale);
const home = localizePath("/", locale);

const isActive = (href: string) =>
  here === href || (href !== "/" && here.startsWith(`${href}/`));
---

<header
  data-header
  data-hero={heroTone === "ink" ? "ink" : undefined}
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-400 data-[stuck]:border-line data-[stuck]:bg-paper/85 data-[stuck]:backdrop-blur-md"
>
  <div class="edge flex h-[68px] items-center justify-between gap-5">
    <a
      href={home}
      class="shrink-0 rounded-[2px]"
      aria-label="Bisa Baik Bersama"
    >
      <Image
        src={logoLight}
        alt="Bisa Baik Bersama"
        width={260}
        densities={[1, 2]}
        loading="eager"
        class="logo-on-light h-8 w-auto object-contain md:h-9"
      />
      <Image
        src={logoDark}
        alt="Bisa Baik Bersama"
        width={260}
        densities={[1, 2]}
        loading="eager"
        class="logo-on-dark h-8 w-auto object-contain md:h-9"
      />
    </a>

    <nav
      class="hidden items-center gap-x-4 lg:flex xl:gap-x-6"
      aria-label={locale === "id" ? "Navigasi utama" : "Primary"}
    >
      {
        t.nav.map((item) => (
          <a
            href={localizePath(item.href, locale)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "nav-link relative whitespace-nowrap py-1 text-[13px] transition-colors duration-200",
              isActive(item.href)
                ? "text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:bg-bronze"
                : "text-ink-soft hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5">
      <a
        href={localizePath(here, other)}
        hreflang={other === "id" ? "id" : "en"}
        title={t.localeSwitchLabel}
        class="header-chip hidden h-9 items-center rounded-[2px] border border-line px-2.5 text-[12px] font-medium tracking-[0.06em] text-ink-soft uppercase transition-colors duration-200 hover:border-ink hover:text-ink sm:inline-flex"
      >
        {other === "id" ? "ID" : "EN"}
      </a>

      <button
        type="button"
        data-theme-toggle
        class="header-chip inline-flex h-9 w-9 items-center justify-center rounded-[2px] border border-line text-ink-soft transition-colors duration-200 hover:border-ink hover:text-ink"
        aria-label={t.theme.label}
        data-label-light={t.theme.light}
        data-label-dark={t.theme.dark}
      >
        <Icon name="ph:sun" class="hidden h-4 w-4 dark:block" />
        <Icon name="ph:moon-stars" class="h-4 w-4 dark:hidden" />
      </button>

      <a
        href={t.aggregatorCta.href}
        target="_blank"
        rel="noopener noreferrer"
        class:list={["btn ml-1 hidden xl:inline-flex", heroTone === "ink" ? "btn-outline-invert" : "btn-primary"]}
      >
        {t.aggregatorCta.label}
        <Icon name="ph:arrow-up-right" class="h-3.5 w-3.5" />
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={t.menu.open}
        data-label-open={t.menu.open}
        data-label-close={t.menu.close}
        class="header-burger -mr-1.5 inline-flex h-9 w-9 items-center justify-center rounded-[2px] text-ink lg:hidden"
      >
        <Icon name="ph:list" class="h-5 w-5" data-menu-icon="open" />
        <Icon name="ph:x" class="hidden h-5 w-5" data-menu-icon="close" />
      </button>
    </div>
  </div>

  <div
    id="site-menu"
    data-menu-panel
    hidden
    class="border-t border-line bg-paper lg:hidden"
  >
    <div class="edge flex max-h-[calc(100dvh-68px)] flex-col overflow-y-auto py-6">
      <nav
        class="flex flex-col divide-y divide-hairline"
        aria-label={locale === "id" ? "Navigasi seluler" : "Mobile"}
      >
        {
          t.nav.map((item) => (
            <a
              href={localizePath(item.href, locale)}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "flex items-center justify-between py-3.5 text-[15px]",
                isActive(item.href) ? "text-ink" : "text-ink-soft",
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span aria-hidden="true" class="h-1 w-1 rounded-full bg-bronze" />
              )}
            </a>
          ))
        }
      </nav>

      <div class="mt-6 flex flex-col gap-2">
        <a
          href={t.aggregatorCta.href}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary justify-between"
        >
          {t.aggregatorCta.label}
          <Icon name="ph:arrow-up-right" class="h-4 w-4" />
        </a>
        <a
          href={localizePath(here, other)}
          hreflang={other === "id" ? "id" : "en"}
          class="btn btn-quiet justify-between sm:hidden"
        >
          {t.localeSwitchLabel}
          <Icon name="ph:translate" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    // A one-pixel IntersectionObserver sentinel at the viewport edge proved
    // unreliable, and getting this wrong makes the logo unreadable, so the
    // state is read straight from the scroll position. The listener is
    // passive and coalesced into one frame, so it costs a boolean compare.
    let ticking = false;
    let stuck: boolean | null = null;

    const apply = () => {
      ticking = false;
      const next = window.scrollY > 8;
      if (next === stuck) return;
      stuck = next;
      header.toggleAttribute("data-stuck", next);
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
  const openIcon = document.querySelector<HTMLElement>('[data-menu-icon="open"]');
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-icon="close"]');

  function setMenu(open: boolean) {
    if (!toggle || !panel) return;
    panel.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "",
    );
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (toggle?.getAttribute("aria-expanded") !== "true") return;
    setMenu(false);
    toggle.focus();
  });

  // The drawer only exists below lg; if the viewport grows past it, reset.
  const wide = window.matchMedia("(min-width: 1024px)");
  wide.addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });
</script>
